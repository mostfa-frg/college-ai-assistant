# Choose groq or gemini
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Gemini (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional web research fallback when no local course evidence is found
TAVILY_API_KEY=
WEB_RESEARCH_ENABLED=true
